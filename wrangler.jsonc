// Cloudflare deployment: a Worker with static assets only, no script.
// "npx wrangler deploy" uploads dist/ after "node build.mjs".
{
  "name": "ownyourniimbot",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Serve the site on the custom domains only.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "ownyourniimbot.com", "custom_domain": true },
    { "pattern": "www.ownyourniimbot.com", "custom_domain": true }
  ]
}
